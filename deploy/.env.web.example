# Copy to /data/workspace/one/.env.web and edit before starting the service.
# Default binding is 0.0.0.0; use 127.0.0.1 when a local Nginx proxy fronts the app.
ONE_WEB_HOST=0.0.0.0
# Replace with your own HTTPS origin, without a path or trailing slash.
ONE_WEB_PUBLIC_ORIGIN=https://sheeridverify.example.edu
# Login account. Either a single account:
ONE_WEB_USERNAME=ops
# Passwords may be plaintext or pre-hashed as sha256:<64 hex>. Never use this placeholder.
ONE_WEB_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
# ...or multiple comma-separated accounts: ONE_WEB_USERS=ops:pass1,audit:sha256:<64 hex>
